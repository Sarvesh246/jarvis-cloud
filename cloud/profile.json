{
  "model": {
    "provider": "custom:cloud-openrouter",
    "default": "openrouter/free"
  },
  "providers": {
    "cloud-openrouter": {
      "name": "OpenRouter free pool",
      "api": "https://openrouter.ai/api/v1",
      "api_key": "${OPENROUTER_API_KEY}",
      "transport": "chat_completions",
      "default_model": "openrouter/free",
      "request_timeout_seconds": 180,
      "stale_timeout_seconds": 60,
      "models": ["openrouter/free"]
    }
  },
  "agent": {
    "max_turns": 60,
    "api_max_retries": 1,
    "auto_recovery_cycles": 1,
    "run_budget_seconds": 180,
    "agent_cache": {
      "max_size": 1,
      "idle_ttl_secs": 60,
      "memory_high_mb": 320,
      "protect_recent": 0
    }
  },
  "gateway": {
    "max_concurrent_runs": 1,
    "api_server": {
      "enabled": true,
      "max_concurrent_runs": 1,
      "history_tool_output_max_chars": 6000
    }
  },
  "platform_toolsets": {
    "api_server": [
      "file",
      "terminal",
      "web",
      "memory",
      "session_search",
      "todo"
    ]
  },
  "terminal": {
    "backend": "local",
    "cwd": "/opt/data/workspace",
    "timeout": 120
  },
  "memory": { "memory_enabled": true, "user_profile_enabled": true },
  "compression": { "enabled": true },
  "auxiliary": {
    "background_review": { "enabled": false },
    "title_generation": { "model_upgrade_enabled": false }
  },
  "plugins": { "enabled": ["jarvis-cloud-research"], "disabled": [] },
  "streaming": { "enabled": true },
  "updates": { "check": false },
  "telemetry": { "shared_metrics": { "enabled": false, "send": false } },
  "tool_loop_guardrails": { "non_interactive_hard_stop_enabled": true }
}
