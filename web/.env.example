# These variables are server-only. No VITE_ secrets.
APP_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL=you@example.com
SESSION_SECRET=
JARVIS_API_URL=https://jarvis-cloud-m2kk.onrender.com
JARVIS_API_KEY=
# Neon Postgres storage for conversations and Workroom documents.
DATABASE_URL=
USAGE_INGEST_KEY=
USAGE_READ_KEY=
# Desktop dictation uses one of these server-side speech providers.
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash

# Optional shared relay journal (same independent secret on relay and web).
RUN_STORE_KEY=
# Set on the relay only: https://your-app.example/api/feed
VAELO_RUN_STORE_URL=

# Authorizes daily deletion of expired transient run events.
CRON_SECRET=
