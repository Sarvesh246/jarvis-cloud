{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaelo",
  "version": "0.1.6",
  "identifier": "app.vaelo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Vaelo", "width": 1200, "height": 820, "minWidth": 480, "minHeight": 560, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' blob: ipc: http://ipc.localhost https://ipc.localhost https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'self'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwNzg4Q0ZCNkM2MkUxODUKUldTRjRXSnMrNHg0b0ZCL05aVUc4ZHp3aHdQYlcxSDJTcFVRSFoxaThwS2RaNlJZTzBoZU9MaDAK",
      "endpoints": ["https://github.com/Sarvesh246/jarvis-cloud/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A calm, capable presence for questions, ideas, and everyday work.",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "entitlements": "Entitlements.plist", "infoPlist": "Info.plist" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
