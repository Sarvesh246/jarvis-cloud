# Generate a separate random key for the private Jarvis API.
API_SERVER_KEY=

# Required: an existing OpenRouter key. The model route is free-only.
OPENROUTER_API_KEY=

# Optional free-provider fallbacks and research backends.
NVIDIA_API_KEY=
# Google AI Studio key; Gemini is tried after NVIDIA. GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional FreeLLMAPI router (HTTPS only). When set it leads; the keys above become fallbacks.
FREELLMAPI_URL=
FREELLMAPI_API_KEY=
# Render free instances sleep after 15 idle minutes; 0 stops the self-ping that prevents it.
KEEP_AWAKE=
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Structured public data. Vaelo currently qualifies for Open-Meteo's noncommercial endpoint.
OPEN_METEO_API_KEY=
# Change to 0 if the app becomes commercial, then supply a subscribed key above.
OPEN_METEO_NONCOMMERCIAL=1
# Enable only after reviewing MusicBrainz's commercial terms.
MUSICBRAINZ_ENABLED=
REST_COUNTRIES_API_KEY=
COINGECKO_API_KEY=
TMDB_READ_TOKEN=
NASA_API_KEY=
# Free noncommercial public-data feeds. Never put keys in VITE_* variables.
PUBLIC_DATA_NONCOMMERCIAL=1
GNEWS_API_KEY=
PRODUCTHUNT_TOKEN=
GUARDIAN_API_KEY=
OMDB_API_KEY=
# NewsAPI's free key is local-development only. Keep the switch off on servers.
NEWSAPI_API_KEY=
NEWSAPI_LOCAL_DEVELOPMENT=0

# Optional no-cost public-read credentials for directory adapters.
# Leave absent to use web fallback. These are server-only settings.
API_FOOTBALL_KEY=
AQICN_TOKEN=
BALLDONTLIE_API_KEY=
COMPANIES_HOUSE_API_KEY=
COOPER_HEWITT_TOKEN=
EBIRD_API_KEY=
ETHERSCAN_API_KEY=
EUROPEANA_API_KEY=
FOODDATA_API_KEY=
FOOTBALL_DATA_TOKEN=
FRED_API_KEY=
HARVARD_ART_API_KEY=
LASTFM_API_KEY=
OPENWEATHER_API_KEY=
THE_DOG_API_KEY=
WEATHERAPI_KEY=
WEATHERBIT_API_KEY=
WMATA_API_KEY=
